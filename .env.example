# Banco — conexão direta, sem pooler (§4.1)
DATABASE_URL="postgresql://calendario:calendario@localhost:5433/calendario"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# URL pública do app. Obrigatória em produção atrás de reverse proxy (EasyPanel) —
# sem ela, Auth.js v5 recusa o host com UntrustedHost. Opcional em dev local.
AUTH_URL=""

# Volume das artes de evento (§4.1)
UPLOAD_DIR="./uploads"

# Base pública, usada no snippet de embed e no feed .ics
NEXT_PUBLIC_APP_URL="http://localhost:3000"
